{
  "name": "vibetree-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "VibeTree - Vibe code with AI in parallel git worktrees",
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "pnpm build:deps && pnpm --filter @vibetree/desktop dev",
    "dev:desktop:debug": "pnpm build:deps && pnpm --filter @vibetree/desktop dev:debug",
    "dev:desktop:reset": "pnpm fix:electron && pnpm dev:desktop",
    "dev:core": "pnpm --filter @vibetree/core dev",
    "dev:server-core": "pnpm --filter @vibetree/server-core dev",
    "build": "turbo run build",
    "build:deps": "pnpm --filter @vibetree/core build && pnpm --filter @vibetree/server-core build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:desktop": "pnpm --filter @vibetree/desktop package",
    "fix:electron": "./scripts/fix-electron.sh",
    "postinstall": "pnpm fix:electron",
    "prepare": "husky",
    "start:desktop": "pnpm --filter @vibetree/desktop start"
  },
  "keywords": [
    "git",
    "worktree",
    "terminal",
    "ai-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "aider",
    "parallel-development",
    "electron",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "prettier": "^3",
    "turbo": "^1.11.2"
  },
  "packageManager": "pnpm@8.14.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
